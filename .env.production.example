# Copy to .env.production on the Linux host. Never commit the real file.

# Image and published HTTP port
IMAGE_TAG=local
HTTP_PORT=80

# Backend runtime
SECRET_KEY=replace-with-a-long-random-production-secret
JWT_SECRET_KEY=replace-with-another-long-random-production-secret
LOG_LEVEL=INFO

# PostgreSQL runtime
POSTGRES_DB=esr_platform
POSTGRES_USER=esr
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://esr:replace-with-a-url-encoded-database-password@db:5432/esr_platform

# Persistent source data on the Linux host; mounted read-only in Backend and Worker.
ESR_SOURCE_RASTER_HOST_DIR=/srv/esr-platform/source

# Backend runtime limits
ESR_RESULT_TTL_HOURS=24
ESR_MAX_BUFFER_METERS=5000
ESR_MAX_ANALYSIS_AREA_KM2=50

# Frontend build-time public configuration. These values are embedded in the bundle.
VITE_AMAP_JS_API_KEY=replace-with-your-public-amap-js-api-key
VITE_AMAP_SECURITY_JS_CODE=replace-with-your-public-amap-security-js-code
VITE_AMAP_CENTER_LNG=118.9000
VITE_AMAP_CENTER_LAT=32.1000
VITE_AMAP_ZOOM=13
