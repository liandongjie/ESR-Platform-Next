# Environment and secrets
.env
.env.*
!.env.example
!.env.production.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Node
node_modules/
dist/
.vite/
coverage/

# Runtime data and logs
data/source/*
!data/source/.gitkeep
data/runtime/*
!data/runtime/.gitkeep
logs/
tmp/
temp/
scripts/load-test/*.local.json
scripts/load-test/results/

# Geospatial data and generated exports
*.tif
*.tiff
*.img
*.vrt
*.ovr
*.aux.xml
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg
*.kml
*.kmz
*.geojson
*.zip
*.pdf
*.png
*.jpg
*.jpeg

# Keep source-controlled assets where explicitly whitelisted
!frontend/src/assets/**/*.png
!frontend/src/assets/**/*.jpg
!docs/**/*.png
!docs/**/*.jpg

# Databases, backups, and logs
*.sqlite
*.sqlite3
*.db
*.dump
*.backup
*.log

# IDE / OS
.vscode/
.idea/
.playwright-cli/
.DS_Store
Thumbs.db

# TypeScript incremental build metadata
*.tsbuildinfo
