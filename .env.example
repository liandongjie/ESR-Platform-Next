# Application
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-another-long-random-string
LOG_LEVEL=INFO
ESR_REGISTRATION_ENABLED=true

# Database
POSTGRES_DB=esr_platform
POSTGRES_USER=esr
POSTGRES_PASSWORD=esr_dev_password
DATABASE_URL=postgresql+psycopg://esr:esr_dev_password@db:5432/esr_platform
ESR_DB_POOL_SIZE=5
ESR_DB_MAX_OVERFLOW=0
ESR_DB_POOL_TIMEOUT_SECONDS=10
ESR_DB_POOL_RECYCLE_SECONDS=1800

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Data paths inside containers
ESR_SOURCE_RASTER_DIR=/data/source
ESR_RUNTIME_DATA_DIR=/data/runtime
ESR_RESULT_TTL_HOURS=24
ESR_MAX_BUFFER_METERS=5000
ESR_MAX_ANALYSIS_AREA_KM2=50
ESR_MAX_ACTIVE_JOBS_PER_USER=3
ESR_SUBMISSION_RATE_LIMIT_PER_MINUTE=10
ESR_CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=300
ESR_CELERY_TASK_TIME_LIMIT_SECONDS=360
ESR_CELERY_MAX_TASKS_PER_CHILD=20
ESR_CELERY_VISIBILITY_TIMEOUT_SECONDS=420
ESR_DISPATCH_RECONCILE_INTERVAL_SECONDS=30
ESR_RESULT_CLEANUP_INTERVAL_SECONDS=300

# Host path mounted read-only by Docker Compose.
# Windows example: D:/ESR-Platform/static/tif
ESR_SOURCE_RASTER_HOST_DIR=./data/source

# Frontend / AMap
VITE_API_BASE_URL=/api/v1
VITE_DEV_PROXY_TARGET=http://localhost:5000
VITE_AMAP_JS_API_KEY=
VITE_AMAP_SECURITY_JS_CODE=
VITE_AMAP_CENTER_LNG=118.9000
VITE_AMAP_CENTER_LAT=32.1000
VITE_AMAP_ZOOM=13
